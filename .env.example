# Copy this file to .env.local and fill in your own values.
# .env and .env.local are both gitignored; this file is
# the only one that's tracked, and it documents names only, no real values.

# Supabase Postgres. Put real credentials in .env.local, never in this file.
# Runtime: pooled transaction-mode URL (normally port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true
# Each successful camera/retry transition refreshes this inactivity window.
PUTAWAY_INACTIVITY_TIMEOUT_MS=240000
# Prisma CLI/migrations: direct session URL (normally port 5432).
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Server-only Supabase access for camera Storage and Realtime.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Dedicated PostgreSQL database used only by Vitest; its URL must contain `test-warehouse`.
# TEST_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/test-warehouse

# Gantry (Milestone 4). SIMULATION runs a deterministic in-process simulator;
# HARDWARE is reserved for a later milestone and is rejected until one is
# implemented.
GANTRY_MODE=simulation
# Camera mode is independent of gantry mode. PROD uses the Pi; SIMULATION
# only supports configured demo bins and still writes to your database.
AUDIT_CAPTURE_MODE=PROD

# Optional simulator pacing, in milliseconds. Defaults: move 300, pick 200,
# drop 200, home 400.
# GANTRY_SIM_MOVE_DELAY_MS=300
# GANTRY_SIM_PICK_DELAY_MS=200
# GANTRY_SIM_DROP_DELAY_MS=200
# GANTRY_SIM_HOME_DELAY_MS=400
# Guided putaway: presenting and returning a bin each take five seconds.
# GANTRY_SIM_BIN_TRANSFER_DELAY_MS=5000

# Raspberry Pi 5 camera worker. Supabase Realtime wakes the authenticated
# worker through the app event stream; it uploads one full-resolution JPEG
# per durable capture job.
CAMERA_DEVICE_ID=warehouse-camera-01
# CAMERA_DEVICE_TOKEN=
# Empty container weight subtracted from every physical putaway scale reading.
PUTAWAY_CONTAINER_TARE_GRAMS=107
# Gross total used when a putaway worker cannot supply a scale reading.
PUTAWAY_FALLBACK_TOTAL_WEIGHT_GRAMS=150
# LAN URL exposed by the Pi's single camera-owner process.
# CAMERA_STREAM_URL=http://warehouse-pi.local:8000/stream.mjpg
# Renewable device lease after the Pi claims a frame request. Pending jobs do
# not use this clock. Defaults to 120 seconds.
# CAMERA_CAPTURE_TIMEOUT_SECONDS=120
# Long-stop cleanup for a queued camera job abandoned by its workflow.
# CAMERA_ABANDONED_TIMEOUT_SECONDS=86400
# Maximum seconds an uploaded frame may remain in server-side processing.
# CAMERA_PROCESSING_TIMEOUT_SECONDS=300
# Maximum accepted JPEG upload size.
# CAMERA_MAX_UPLOAD_MB=12
# Optional persistent directory; defaults to data/camera-captures.
# CAMERA_CAPTURE_DIR=/absolute/path/to/camera-captures

# Warehouse Agent (Milestone 5) — Strands + Amazon Bedrock.
# Region and model id are configuration, not secrets.
AWS_REGION=us-west-2

# Code default if unset: global.anthropic.claude-sonnet-5 (must carry a
# `global.` or `us.` inference-profile prefix — a bare `anthropic.*` id is
# rejected). Override here if your account's Bedrock access requires a
# different model (e.g. an Amazon Nova model if Anthropic access is blocked).
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5

# Engineer day-by-day build plan used read-only by the Materials Planner.
# Share this Sheet with the service-account email below, or use an API key only
# when the Sheet is intentionally readable through the Sheets API.
ENGINEERING_PLAN_SPREADSHEET_ID=YOUR_SPREADSHEET_ID
ENGINEERING_PLAN_SHEET_RANGE=UpdatedPlan!A1:O250
ENGINEERING_PLAN_TIME_ZONE=Asia/Ulaanbaatar
# GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=rackhand-sheets@PROJECT_ID.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternative for a Sheet intentionally exposed to API-key access:
# GOOGLE_SHEETS_API_KEY=

# --- Secrets: put these in .env.local, never here ---
#
# GEMINI_API_KEY — Google AI Studio key (aistudio.google.com/apikey), used
# only by the vision/measurement pipeline (app/api/measure/route.ts).
# GEMINI_API_KEY=
#
# Bedrock credential — resolved through the standard AWS chain. Either a
# bearer token (recent AWS SDKs prefer this for Bedrock):
# AWS_BEARER_TOKEN_BEDROCK=
# ...or a sigv4 access key pair:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Prisma seed (prisma/seed.ts): set to "0" to skip creating demo catalog
# parts. Unset seeds them normally.
# SEED_DEMO_CATALOG=0
