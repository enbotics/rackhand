generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A canonical warehouse catalog item. Authoritative identity.
model Part {
  id                String              @id @default(cuid())
  sku               String              @unique
  canonicalName     String
  category          String?
  description       String?
  /// Nullable throughout: the catalog may know a part before it knows its
  /// size. Never negative — enforced by the validation layer.
  lengthMM          Float?
  widthMM           Float?
  heightMM          Float?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  /// Whether this kind of part is typically checked out and returned (a
  /// shared tool like a screwdriver) rather than consumed/installed by
  /// whoever takes it (small hardware, single-use items). Classified once by
  /// an LLM when the part is first created (see
  /// src/lib/agents/returnability-classifier.ts) — never inferred from
  /// stock levels or movement history. Defaults false: an unclassified or
  /// misclassified part is safer treated as "not shared" than the reverse.
  returnable        Boolean             @default(false)
  /// The representative photo used to RECOGNIZE this part — shown as a
  /// clickable candidate tile when a human disambiguates an AMBIGUOUS scan,
  /// so identity is chosen by sight, not by reading a generated SKU. Set
  /// once, at registration time, from the scan that created the part (see
  /// catalog-registration-service.ts); null for parts with no such scan (the
  /// seeded demo catalog, or a part created via the plain parts API).
  /// Unrelated to Movement.imageUrl, which is a per-putaway-event audit photo
  /// for the bin-detail modal, not an identification aid.
  imageUrl          String?
  expectedBinAudits BinAudit[]
  resolutions       CatalogResolution[]
  inventory         Inventory[]
  movements         Movement[]

  @@index([category])
}

/// A physical storage location. Gantry coordinates belong to a later
/// milestone and are deliberately absent.
model Bin {
  id                   String      @id @default(cuid())
  code                 String      @unique
  /// BinStatus: AVAILABLE | RESERVED | OCCUPIED | CHECKED_OUT | AUDITING | DISABLED
  status               String      @default("AVAILABLE")
  /// Maximum total units this bin may hold.
  capacity             Int         @default(100)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  binAudits            BinAudit[]
  inventory            Inventory[]
  movementsToThisBin   Movement[]  @relation("MovementDestination")
  movementsFromThisBin Movement[]  @relation("MovementSource")

  @@index([status])
}

/// Current stock of one part in one bin.
model Inventory {
  id        String   @id @default(cuid())
  partId    String
  binId     String
  /// Never negative — enforced in the inventory service, inside a transaction.
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bin       Bin      @relation(fields: [binId], references: [id])
  part      Part     @relation(fields: [partId], references: [id])

  @@unique([partId, binId])
  @@index([binId])
}

/// A requested warehouse state transition. Creating one does NOT mean a
/// gantry moved anything — the physical lifecycle is a later milestone.
model Movement {
  id                     String                 @id @default(cuid())
  /// MovementType: PUTAWAY | RETRIEVAL | TRANSFER | ADJUSTMENT
  type                   String
  partId                 String
  quantity               Int
  /// MovementStatus: PENDING | VALIDATED | RUNNING | PRESENTING |
  /// AWAITING_PLACEMENT | RETURNING | READY_TO_COMMIT | READY_TO_CANCEL |
  /// COMPLETED | FAILED | CANCELLED
  status                 String                 @default("PENDING")
  /// Nullable: a putaway starts at an intake station, a retrieval ends at an
  /// output station. Those stations are free-text locations rather than fake
  /// Bin rows, so bin availability logic never sees them.
  sourceBinId            String?
  destinationBinId       String?
  sourceLocation         String?
  destinationLocation    String?
  /// The ScanResult this movement came from (Milestone 7 putaway).
  /// Durable provenance — never cleared, so a failed attempt stays traceable.
  scanId                 String?
  /// The GantryOperation this movement was executed by (Milestone 7).
  /// The warehouse Movement is intent; the GantryOperation is the machine's
  /// account of carrying it out. Recorded for both outcomes so a failed or
  /// half-committed putaway can be reconciled against machine history.
  /// Not a foreign key: gantry history is process-local, not a database table.
  gantryOperationId      String?
  /// Idempotency lock for putaway (Milestone 7). Holds the scanId while the
  /// putaway is PENDING/VALIDATED/RUNNING/COMPLETED, and is cleared when the
  /// movement reaches FAILED or CANCELLED so the operator may retry the same
  /// physical scan. Unique rather than checked-then-written, so two concurrent
  /// submissions of one scan cannot both claim it.
  idempotencyKey         String?                @unique
  createdAt              DateTime               @default(now())
  /// Set only when a movement actually reaches a terminal state.
  completedAt            DateTime?
  /// The photo captured for this scan, uploaded to Supabase Storage. Only
  /// ever set for PUTAWAY movements. Historical — kept even if the movement
  /// later CANCELLED/FAILED, since the upload happens before the outcome is
  /// known and there is nothing to gain from deleting it after the fact.
  imageUrl               String?
  newQuantity            Int?
  /// Set only for type ADJUSTMENT — a direct operator override of a bin's
  /// quantity, from the bin-detail modal. The precise before/after, since
  /// `quantity` above holds the size of the change (always positive) to stay
  /// consistent with what every other movement type means by that field.
  previousQuantity       Int?
  /// Fresh manual bin snapshot accepted before putaway. The putaway verifier
  /// compares its count to recorded stock; inventory auditing remains the
  /// independent full-audit workflow.
  verificationImageUrl   String?
  verificationCapturedAt DateTime?
  /// Gross scale reading for the verified bin, including its container.
  totalWeightGrams       Float?
  /// Container tare used for this measurement. Persisted so historical
  /// calculations remain explainable if the configured box changes later.
  tareWeightGrams        Float?
  /// totalWeightGrams - tareWeightGrams.
  netWeightGrams         Float?
  /// netWeightGrams divided by the camera-confirmed quantity.
  unitWeightGrams        Float?
  /// SCALE | FALLBACK. Prevents a synthetic continuity value from being
  /// presented later as a physical measurement.
  weightSource           String?
  destinationBin         Bin?                   @relation("MovementDestination", fields: [destinationBinId], references: [id])
  part                   Part                   @relation(fields: [partId], references: [id])
  sourceBin              Bin?                   @relation("MovementSource", fields: [sourceBinId], references: [id])
  putawayCapture         PutawayCaptureRequest?

  @@index([status])
  @@index([createdAt])
  @@index([scanId])
  @@index([destinationBinId, verificationCapturedAt])
}

/// Durable Raspberry Pi camera and human-review state for one putaway. Unlike an
/// inventory audit, this only decides whether the presented bin may return;
/// the accepted quantity is committed by the parent Movement after gantry
/// completion.
model PutawayCaptureRequest {
  id                     String    @id @default(cuid())
  movementId             String    @unique
  /// WAITING_FOR_CAMERA | CAPTURING | READY | REVIEW_DECREASE |
  /// RETRY_REQUIRED | ACCEPTED | FAILED
  status                 String    @default("WAITING_FOR_CAMERA")
  expectedQuantity       Int
  observedQuantity       Int?
  countConfidence        Float?
  countable              Boolean?
  expectedPartPresent    Boolean?
  foreignObjectSuspected Boolean?
  foreignObjectsJson     String?
  occlusion              String?
  notes                  String?
  previousImageUrl       String?
  evidenceUrl            String?
  imageWidth             Int?
  imageHeight            Int?
  attempt                Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  /// Processing lease. Null while waiting for a human; renewed only while
  /// server-side image analysis is actively running.
  expiresAt              DateTime?
  capturedAt             DateTime?
  /// Browser/operator workflow that owns this popup and its decisions.
  ownerSessionId         String?
  totalWeightGrams       Float?
  tareWeightGrams        Float?
  netWeightGrams         Float?
  unitWeightGrams        Float?
  weightSource           String?
  movement               Movement  @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([ownerSessionId, status, createdAt])
}

/// Audit record of one human approval decision for a state-changing agent
/// action (Milestone 9).
///
/// The Strands interrupt state itself lives in a bounded in-process store — it
/// is runtime execution state, not warehouse truth, and must not survive a
/// restart as something resumable. What belongs here is the DECISION: who
/// approved what, when, and what it was approved to do. That is auditable
/// warehouse history.
///
/// Never contains model reasoning, prompts, credentials or images.
model ActionApproval {
  id          String    @id
  /// The tool the agent tried to call, e.g. "execute_putaway".
  toolName    String
  /// Sanitized JSON summary shown to the operator: part, source, destination,
  /// quantity. The exact arguments the approval is bound to.
  summary     String
  /// PENDING | APPROVED | DENIED | EXPIRED. Terminal states never reopen.
  status      String    @default("PENDING")
  /// The Strands interrupt this approval authorises. Binding is exact: an
  /// approval can never be applied to a different tool call.
  interruptId String
  /// The originating request id, reused on resume so approving twice cannot
  /// execute the underlying operation twice.
  requestId   String
  /// The observability trace this approval belongs to (Milestone 12).
  /// Nullable because it is correlation, not authorization — an approval whose
  /// trace failed to write is still a valid approval. It is what lets an
  /// EXPIRED decision be reported on the timeline it interrupted, long after
  /// the in-process snapshot is gone.
  traceId     String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  resolvedAt  DateTime?

  @@index([status])
  @@index([createdAt])
}

/// A human decision about which catalog Part an AMBIGUOUS scan represents
/// (Milestone 9).
///
/// Deliberately NOT a matcher output. The deterministic matcher stays
/// authoritative about machine confidence and never returns MATCHED for an
/// ambiguous scan; this records that a person took responsibility for the
/// identity instead. Keeping them separate preserves the provenance of every
/// stored unit of stock.
model CatalogResolution {
  id                  String    @id
  /// The scan this decision belongs to. A resolution authorises exactly one
  /// scan — it can never be replayed against a different one.
  scanId              String
  /// What the matcher said. Only AMBIGUOUS is resolvable: NO_MATCH means there
  /// were no plausible candidates, and inventing one is a different workflow.
  originalMatchStatus String
  /// JSON array of the part ids offered. The operator may confirm one of
  /// these and nothing else, however the request is crafted.
  candidatePartIds    String
  selectedPartId      String?
  /// PENDING | CONFIRMED | REJECTED | EXPIRED. Terminal states never reopen,
  /// and a CONFIRMED selection is immutable.
  status              String    @default("PENDING")
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  resolvedAt          DateTime?
  selectedPart        Part?     @relation(fields: [selectedPartId], references: [id], onDelete: Restrict)

  @@index([scanId])
  @@index([status])
}

/// One observability record per agent request (Milestone 12).
///
/// OBSERVATIONAL, NEVER AUTHORITATIVE. Inventory, Bin, Movement and Part are
/// the warehouse's truth; these rows only describe what happened on the way
/// there. Nothing may read a trace to decide warehouse state, and a failed
/// trace write must never fail — or retry — a physical operation.
///
/// Never contains model reasoning, prompts, credentials or image bytes. The
/// request summary is a bounded excerpt of the operator's own words, capped in
/// src/lib/observability/sanitize.ts.
model AgentTrace {
  id             String       @id
  /// RUNNING | WAITING_FOR_APPROVAL | COMPLETED | BLOCKED | FAILED | DENIED | EXPIRED
  status         String       @default("RUNNING")
  /// Truncated operator request. Never a system prompt or model output.
  requestSummary String
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  durationMs     Int?
  errorCode      String?
  errorMessage   String?
  /// Small summary from the Strands AgentResult's own metrics. All nullable:
  /// a trace must never depend on the SDK reporting metrics.
  modelCalls     Int?
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  modelLatencyMs Int?
  createdAt      DateTime     @default(now())
  events         TraceEvent[]

  @@index([status])
  @@index([startedAt])
}

/// One step in a trace's timeline (Milestone 12).
///
/// `sequence` is assigned by the trace service and is the display order —
/// database row order is not relied on, and two events in the same millisecond
/// still order deterministically.
model TraceEvent {
  id           String     @id @default(cuid())
  traceId      String
  /// See TRACE_EVENT_TYPES in src/lib/observability/types.ts.
  type         String
  /// Monotonic within one trace, starting at 1.
  sequence     Int
  /// STARTED | COMPLETED | BLOCKED | FAILED | INFO
  status       String
  /// Tool name, graph node id, or similar. Null for events with no subject.
  name         String?
  /// One operator-readable sentence, built from warehouse facts.
  summary      String
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?
  /// Small sanitized JSON. Never a raw server object, image or prompt.
  metadataJson String?
  createdAt    DateTime   @default(now())
  trace        AgentTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@unique([traceId, sequence])
  @@index([traceId])
}

/// One explicitly requested inventory-audit run. There is no nightly scheduler;
/// runs are started by the Warehouse Agent or a trusted internal invocation.
/// trigger: CLIENT | TRUSTED_INTERNAL | PLAN_VERIFICATION — PLAN_VERIFICATION
/// is the materials-plan stock check: same automatic-capture/no-approval
/// behavior as TRUSTED_INTERNAL, but targets an explicit bin list and skips
/// the daily-activity eligibility/cooldown gate, which has nothing to do
/// with "does this build have enough stock."
model InventoryAuditRun {
  id                 String              @id @default(cuid())
  trigger            String
  status             String              @default("PENDING")
  requestedBinCode   String?
  /// "ACTIVE" while running, null when terminal. The unique constraint is the
  /// cross-process lock that prevents two gantry audits from running together.
  activeKey          String?             @unique
  binsPlanned        Int                 @default(0)
  binsCompleted      Int                 @default(0)
  verifiedBins       Int                 @default(0)
  reconciledBins     Int                 @default(0)
  reviewRequiredBins Int                 @default(0)
  failedBins         Int                 @default(0)
  startedAt          DateTime            @default(now())
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  binAudits          BinAudit[]
  materialsPlanCheck MaterialsPlanCheck?

  @@index([status])
  @@index([createdAt])
}

/// Ties a Planner's requirements list to the InventoryAuditRun verifying it.
/// Deliberately thin — bin-level detail and progress live entirely on the
/// linked InventoryAuditRun/BinAudit rows; this only remembers what was asked
/// for and the final per-SKU required/available comparison.
model MaterialsPlanCheck {
  id               String            @id @default(cuid())
  /// Browser/operator workflow that requested this check.
  ownerSessionId   String?
  /// The Planner's raw structured output: [{ sku, purpose, category, quantity }]
  requirementsJson String
  auditRunId       String            @unique
  /// Filled once the linked audit run reaches a terminal status:
  /// [{ sku, required, available, status: "AVAILABLE" | "SHORTAGE" }]
  resultJson       String?
  createdAt        DateTime          @default(now())
  completedAt      DateTime?
  auditRun         InventoryAuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  @@index([ownerSessionId, createdAt])
}

/// Persisted physical-vs-digital observation for one bin.
model BinAudit {
  id                     String               @id @default(cuid())
  auditRunId             String
  binId                  String
  expectedPartId         String?
  expectedQuantity       Int
  observedQuantity       Int?
  countConfidence        Float?
  countable              Boolean?
  expectedPartPresent    Boolean?
  foreignObjectSuspected Boolean?
  occlusion              String?
  notes                  String?
  status                 String               @default("PENDING")
  evidenceUrl            String?
  inventoryUpdated       Boolean              @default(false)
  previousQuantity       Int?
  newQuantity            Int?
  errorCode              String?
  errorMessage           String?
  startedAt              DateTime             @default(now())
  capturedAt             DateTime?
  completedAt            DateTime?
  createdAt              DateTime             @default(now())
  /// This bin's last ACCEPTED evidence photo as it stood BEFORE this audit
  /// — the "before" half of the comparison shown for this result, computed
  /// once at finalize time (findLatestAcceptedSnapshot) so it stays fixed
  /// even if a later audit changes what "latest accepted" means.
  priorEvidenceUrl       String?
  capture                AuditCaptureRequest?
  auditRun               InventoryAuditRun    @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  bin                    Bin                  @relation(fields: [binId], references: [id])
  expectedPart           Part?                @relation(fields: [expectedPartId], references: [id], onDelete: Restrict)

  @@unique([auditRunId, binId])
  @@index([binId, createdAt])
  @@index([status])
}

/// Raspberry Pi camera handshake. Image bytes are uploaded by the camera worker;
/// Prisma stores only the durable URL and the structured Gemini result,
/// broken into individual columns (not a JSON blob) to match
/// PutawayCaptureRequest's shape — the two share the same comparison/retry
/// UI and decision-policy helpers, so their durable state should look alike.
///
/// status: WAITING_FOR_CAMERA | CAPTURING | PENDING_ACK | REVIEW_DECREASE |
/// RETRY_REQUIRED | ACCEPTED | FAILED. Unlike PutawayCaptureRequest there is
/// no standalone
/// "READY" status: a safe equal/higher observation needs no human decision,
/// so the capture route finalizes it immediately and writes ACCEPTED
/// directly — REVIEW_DECREASE and RETRY_REQUIRED are the only statuses a
/// human ever actually acts on.
model AuditCaptureRequest {
  id                     String    @id @default(cuid())
  binAuditId             String    @unique
  status                 String    @default("WAITING_FOR_CAMERA")
  evidenceUrl            String?
  imageWidth             Int?
  imageHeight            Int?
  errorCode              String?
  createdAt              DateTime  @default(now())
  /// Processing lease. Null while waiting for a human; renewed only while
  /// server-side image analysis is actively running.
  expiresAt              DateTime?
  capturedAt             DateTime?
  expectedQuantity       Int       @default(0)
  observedQuantity       Int?
  countConfidence        Float?
  countable              Boolean?
  expectedPartPresent    Boolean?
  foreignObjectSuspected Boolean?
  foreignObjectsJson     String?
  occlusion              String?
  notes                  String?
  /// This bin's last ACCEPTED evidence photo — the "before" half of the
  /// comparison dialog. Null when this bin has never had one.
  previousImageUrl       String?
  /// Incremented on every retry; the row is reused, never duplicated.
  attempt                Int       @default(0)
  updatedAt              DateTime  @updatedAt
  /// Browser/operator workflow that owns this popup and its decisions.
  ownerSessionId         String?
  binAudit               BinAudit  @relation(fields: [binAuditId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([ownerSessionId, status, createdAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CameraCaptureJob {
  id                String    @id
  purpose           String
  deviceId          String
  status            String    @default("PENDING")
  binAuditId        String?
  evidenceUrl       String?
  imageWidth        Int?
  imageHeight       Int?
  resultJson        String?
  requestedAt       DateTime  @default(now())
  claimedAt         DateTime?
  capturedAt        DateTime?
  uploadedAt        DateTime?
  completedAt       DateTime?
  /// Null while queued; a renewable lease while CLAIMED/UPLOADED/PROCESSING.
  expiresAt         DateTime?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  /// The PutawayCaptureRequest or AuditCaptureRequest this image must
  /// satisfy. Null only for standalone MANUAL_SCAN jobs.
  workflowCaptureId String?
  /// Attempt number of the owning putaway/audit capture. Late results from a
  /// superseded retry are rejected instead of mutating the current attempt.
  workflowAttempt   Int?
  /// Browser/operator workflow that receives this job's status and result.
  ownerSessionId    String?
  /// Authenticated USB scale reading supplied with a putaway photo.
  totalWeightGrams  Float?
  /// SCALE | FALLBACK.
  weightSource      String?

  @@index([binAuditId])
  @@index([workflowCaptureId, status])
  @@index([deviceId, status, requestedAt])
  @@index([ownerSessionId, status, requestedAt])
  @@index([status])
}

/// Last authenticated health report from one physical Raspberry Pi camera.
/// ONLINE/OFFLINE is derived from lastSeenAt so a crashed worker cannot leave
/// a permanently-green status behind.
model CameraDeviceHealth {
  deviceId          String    @id
  workerState       String    @default("STARTING")
  cameraReady       Boolean   @default(false)
  previewReady      Boolean   @default(false)
  activeJobId       String?
  cpuTemperatureC   Float?
  cpuLoadPercent    Float?
  memoryUsedPercent Float?
  workerVersion     String?
  workerStartedAt   DateTime?
  lastError         String?
  lastSeenAt        DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([lastSeenAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EngineeringPlanAnalysisEvent {
  id                         String                     @id
  runId                      String
  sequence                   Int
  stage                      String
  status                     String
  summary                    String
  metadataJson               String?
  createdAt                  DateTime                   @default(now())
  EngineeringPlanAnalysisRun EngineeringPlanAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EngineeringPlanAnalysisRun {
  id                           String                         @id
  ownerSessionId               String
  trigger                      String                         @default("MANUAL")
  status                       String                         @default("QUEUED")
  stage                        String                         @default("QUEUED")
  activeKey                    String?                        @unique
  workDate                     String
  rowsFound                    Int                            @default(0)
  currentBinCode               String?
  planRowsJson                 String                         @default("[]")
  requirementsJson             String                         @default("[]")
  resultJson                   String?
  errorCode                    String?
  errorMessage                 String?
  startedAt                    DateTime?
  completedAt                  DateTime?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime
  EngineeringPlanAnalysisEvent EngineeringPlanAnalysisEvent[]

  @@index([ownerSessionId, createdAt])
  @@index([status])
}
