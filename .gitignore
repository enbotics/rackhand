# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — all gitignored, including .env. Use .env.example (tracked) to
# document variable names for a fresh clone.
.env*
!.env.example
scale.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# warehouse database (Milestone 2) — the SQLite file is local state, not source
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-shm
/prisma/*.db-wal
/prisma/test-*.db

# generated Prisma client — recreated by `prisma generate` (npm postinstall)
/src/generated
data/camera-captures/
