[Unit]
Description=Warehouse Raspberry Pi live camera and capture worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/warehouse-camera
ExecStart=/usr/bin/python3 -m app.worker
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
