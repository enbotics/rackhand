SERVER_BASE_URL=http://YOUR_APP_HOST:3000
CAMERA_DEVICE_ID=warehouse-camera-01
CAMERA_DEVICE_TOKEN=
REQUEST_TIMEOUT_SECONDS=15
REALTIME_RECONNECT_DELAY_SECONDS=2
LEASE_HEARTBEAT_SECONDS=30
CAMERA_WIDTH=4608
CAMERA_HEIGHT=2592
PREVIEW_WIDTH=1280
PREVIEW_HEIGHT=720
PREVIEW_FPS=15
PREVIEW_PORT=8000
CAMERA_SETTLE_SECONDS=2
AUTOFOCUS_TIMEOUT_SECONDS=8
# Set false on a camera-only Pi. Putaway still succeeds with the fallback total.
SCALE_ENABLED=true
SCALE_SERIAL_PORT=/dev/ttyUSB0
SCALE_BAUD_RATE=19200
SCALE_UNIT=g
SCALE_READ_TIMEOUT_SECONDS=10
SCALE_STABLE_SAMPLES=3
SCALE_STABILITY_TOLERANCE_GRAMS=1
SCALE_FALLBACK_WEIGHT_GRAMS=150
SPOOL_DIR=/home/pi/warehouse-camera/spool
